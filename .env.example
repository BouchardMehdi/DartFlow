# Copiez ce fichier vers .env et remplacez toutes les valeurs CHANGE_ME.
# Le fichier .env ne doit jamais etre versionne.

POSTGRES_DB=dartflow
POSTGRES_USER=dartflow
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD

# Minimum 32 caracteres. Exemple : openssl rand -hex 64
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# URL publique exacte, sans slash final.
FRONTEND_ORIGIN=https://dartflow.bouchard-mehdi.fr

# Ports reserves a DartFlow sur le VPS. Ils sont lies a 127.0.0.1 par Docker.
FRONT_PORT=8088
BACK_PORT=3008

# Laissez vide pour utiliser automatiquement wss://dartflow.bouchard-mehdi.fr/realtime.
NEXT_PUBLIC_REALTIME_URL=

ACCESS_TOKEN_TTL_HOURS=4
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=true
